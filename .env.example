# Copy to .env at the repo root and fill in. .env is gitignored.
# Used by your Templafy generation script (scripts/generate_public_audit_template_2026.py).
TEMPLAFY_BASE_URL=
TEMPLAFY_TOKEN=

# Your real Templafy login email — doc-gen runs AS this user.
# Setting it here is enough; the UI email field overrides it per run.
PROPOSAL_EMAIL=your.name@kpmg.com

# Optional overrides for the app:
# MASTER_PPTX=data/master/master.pptx
# GENERATE_SCRIPT=scripts/generate_public_audit_template_2026.py
