# Copy to .env and fill in. .env is gitignored and must stay that way: the
# client secret is a key to a document library that briefly holds client decks.
#
# Where each value comes from is in docs/graph-findings.md, "Setting it up".

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_DRIVE_ID=

# Optional. The folder inside that drive the renders pass through, so a human
# can open it and see at a glance whether anything was left behind.
# GRAPH_FOLDER=pptgen-render

# Which renderer draws the preview. Unset means `auto`, which walks
# libreoffice -> powerpoint and deliberately never reaches graph: graph is the
# one under evaluation and the only one that leaves this machine, so nothing
# gets there without asking for it by name. This is how you ask.
#
# Set it to `graph` and every preview goes through SharePoint, which is what
# makes the round trip visible. Note that a library with a library.pdf beside
# it is previewed from that PDF instead, without rendering anything - delete it
# to force the real thing.
# PPTGEN_RENDERER=graph

# For showing somebody the round trip. Upload and delete are about two seconds
# apart, which nobody can watch; this holds the deck in the folder for that
# many seconds first, so it can be seen arriving and going. Off unless set,
# capped at 60, and it prints a line to stderr every time it fires.
#
# The demo deck only. While this is set, every render - including a client's
# proposal - leaves a copy in SharePoint for that long. Unset it afterwards;
# `python tools/graph_setup.py check` will tell you if it is still on.
# GRAPH_DEMO_HOLD=20

# Do not delete at all. The copy stays in SharePoint so somebody can open it,
# rather than watch it go past. Prefer GRAPH_DEMO_HOLD above: it needs no
# cleaning up, and this does.
#
# This switches off the one guarantee the Graph backend makes. While it is set,
# EVERY render leaves its deck behind - a client's proposal as readily as the
# demo one - and they stay there, readable by anyone who can open the library,
# until a person removes them. Only 1/true/yes/on turn it on.
#
# Unset it the moment the demo is over, then:
#     python tools/graph_setup.py sweep --delete
# which clears the folder and the recycle bin, because "deleted" in SharePoint
# means "moved somewhere still readable".
# GRAPH_KEEP_UPLOAD=1
